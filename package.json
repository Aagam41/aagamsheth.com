{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static personal academic site — edit YAML, build with GitHub Actions",
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/validate.js",
    "css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "test": "node scripts/smoke-test.js",
    "dev": "node scripts/build.js && tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{site.title}}</title>
  <meta name="description" content="{{site.meta_description}}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap" /></noscript>
  <style>{{{css}}}</style>
  <link rel="icon" href="data:,">
</head>
<body id="top">

  <nav class="site-nav" id="site-nav">
    <div class="site-nav-inner">
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-mobile">
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
      <span class="nav-brand">Aagam Sheth</span>
    </div>
  </nav>

  <div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>

  <div class="nav-mobile" id="nav-mobile">
    <a class="nav-link" href="#top">Home</a>
    {{#each sections}}<a class="nav-link" href="#{{this.id}}">{{this.title}}</a>{{/each}}
  </div>

  <nav class="side-nav" aria-label="Section outline">
    <a href="#top">Home</a>
    {{#each sections}}<a href="#{{this.id}}">{{this.title}}</a>{{/each}}
  </nav>

  <div class="page">

    <header class="hero">
      <h1 class="hero-name">{{header.name}}</h1>
      <div class="hero-row">
        <div class="hero-photo-col">
          <div class="hero-photo">
            <img src="{{lqip header.photo}}" data-src="{{header.photo}}" alt="{{header.name}}" width="400" height="370" loading="eager" fetchpriority="high" decoding="async" class="lazy-img" />
          </div>
          <p class="hero-email">{{emailParts header.email}}</p>
          <p class="hero-socials">{{#each header.links}}<a href="{{this.url}}" target="_blank" rel="noopener">{{this.label}}</a>{{#unless @last}}<span class="sep">|</span>{{/unless}}{{/each}}</p>
        </div>
        <div class="hero-intro-col">
          <div class="hero-intro">{{{header.tagline}}}</div>
        </div>
      </div>
    </header>

    <main>
      {{#each sections}}
      <section class="content-section" id="{{this.id}}">
        <h2 class="section-title">{{this.title}}</h2>
        <div class="section-body section-body--{{this.id}}">
          {{{this.html}}}
        </div>
      </section>
      {{/each}}
    </main>

    <footer class="site-footer">
      <p class="site-footer-line">Applying design and engineering principles to solve complex problems through sound analytical and creative skills</p>
    </footer>

  </div>

  <script>
    (function () {
      // LQIP blur-up: swap low-res placeholder for full image as it enters view
      function upgrade(img) {
        var src = img.getAttribute("data-src");
        if (!src || img.dataset.upgraded) return;
        img.dataset.upgraded = "1";
        var full = new Image();
        full.onload = function () {
          img.src = src;
          img.classList.add("is-loaded");
        };
        full.src = src;
      }
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { upgrade(e.target); io.unobserve(e.target); }
          });
        }, { rootMargin: "200px" });
        document.querySelectorAll("img.lazy-img").forEach(function (img) { io.observe(img); });
      } else {
        document.querySelectorAll("img.lazy-img").forEach(upgrade);
      }
      // Eager images (hero) upgrade immediately
      document.querySelectorAll('img.lazy-img[loading="eager"]').forEach(upgrade);

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/assets/sw.js").catch(function () {});
        });
      }
      var nav = document.getElementById("site-nav");
      var toggle = document.getElementById("nav-toggle");
      function onScroll() {
        nav.classList.toggle("nav--scrolled", window.scrollY > 8);
      }
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // Desktop: slide the navbar down once the user scrolls past the hero name.
      var heroName = document.querySelector(".hero-name");
      function updateNavShown() {
        if (!window.matchMedia("(min-width: 1100px)").matches) {
          nav.classList.remove("nav--shown");
          return;
        }
        if (!heroName) { nav.classList.add("nav--shown"); return; }
        var threshold = heroName.getBoundingClientRect().bottom + window.scrollY - 80;
        nav.classList.toggle("nav--shown", window.scrollY > threshold);
      }
      window.addEventListener("scroll", updateNavShown, { passive: true });
      window.addEventListener("resize", updateNavShown);
      updateNavShown();
      var overlay = document.getElementById("nav-overlay");
      function closeDrawer() {
        nav.classList.remove("nav--open");
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }
      function openDrawer() {
        nav.classList.add("nav--open");
        toggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      toggle.addEventListener("click", function () {
        if (nav.classList.contains("nav--open")) closeDrawer(); else openDrawer();
      });
      if (overlay) {
        overlay.addEventListener("click", closeDrawer);
      }
      var navMobile = document.getElementById("nav-mobile");
      document.addEventListener("click", function (e) {
        if (!nav.classList.contains("nav--open")) return;
        if (nav.contains(e.target)) return;
        if (navMobile && navMobile.contains(e.target)) return;
        closeDrawer();
      });
      document.querySelectorAll("#nav-mobile .nav-link").forEach(function (link) {
        link.addEventListener("click", closeDrawer);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && nav.classList.contains("nav--open")) closeDrawer();
      });
      if ("IntersectionObserver" in window) {
        var spy = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var active = document.querySelector('.side-nav a[href="#' + entry.target.id + '"]');
            if (!active) return;
            document.querySelectorAll(".side-nav a.active").forEach(function (el) {
              el.classList.remove("active");
            });
            active.classList.add("active");
          });
        }, { rootMargin: "-35% 0px -55% 0px" });
        document.querySelectorAll(".content-section").forEach(function (section) {
          spy.observe(section);
        });
      }
      document.querySelectorAll(".js-email").forEach(function (el) {
        var addr = el.getAttribute("data-user") + "@" + el.getAttribute("data-domain");
        el.setAttribute("href", "mailto:" + addr);
      });
    })();
  </script>
</body>
</html>

<div class="pub-item pub-item--detailed">
  {{#if image}}
  <div class="pub-image">
    <img src="{{image}}" alt="{{title}} teaser" loading="lazy" />
  </div>
  {{else}}
  <div class="pub-image pub-image--placeholder">
    <span class="pub-image-placeholder-text">{{title}}</span>
  </div>
  {{/if}}
  <div class="pub-body">
    <div class="pub-title">{{title}}</div>
    <div class="pub-authors">{{{authorsHtml}}}</div>
    <div class="pub-venue">{{venue}}</div>
    {{#if links}}
    <div class="pub-links">
      {{#each links}}<a href="{{this.url}}" class="tag-link" target="_blank" rel="noopener">{{this.label}}</a>{{/each}}
    </div>
    {{/if}}
  </div>
</div>

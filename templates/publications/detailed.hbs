<div class="entry-row">
  {{#if image}}
  <div class="entry-thumb">
    <img src="{{image}}" alt="{{title}} teaser" loading="lazy" />
  </div>
  {{else}}
  <div class="entry-thumb entry-thumb--placeholder">
    <span class="entry-thumb-placeholder-text">{{title}}</span>
  </div>
  {{/if}}
  <div class="entry-info">
    <div class="entry-title">{{title}}</div>
    {{#if authors}}<div class="entry-authors">{{{authorsHtml}}}</div>{{/if}}
    <div class="entry-venue"><em>{{venue}}</em></div>
    {{#if links}}
    <div class="entry-links">
      {{#each links}}<a href="{{this.url}}" class="entry-link" target="_blank" rel="noopener">[{{this.label}}]</a>{{/each}}
    </div>
    {{/if}}
  </div>
</div>

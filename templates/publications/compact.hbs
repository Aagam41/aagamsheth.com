<div class="pub-item pub-item--compact">
  <div class="pub-title">{{title}}</div>
  <div class="pub-authors">{{{authorsHtml}}}</div>
  <div class="pub-venue-inline">{{venue}}</div>
  {{#if links}}
  <div class="pub-links">
    {{#each links}}<a href="{{this.url}}" class="pill-link" target="_blank" rel="noopener">{{this.label}}</a>{{/each}}
  </div>
  {{/if}}
</div>

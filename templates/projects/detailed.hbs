<div class="project-item project-item--detailed">
  {{#if image}}
  <div class="project-image">
    <img src="{{image}}" alt="{{title}}" loading="lazy" />
  </div>
  {{else}}
  <div class="project-image project-image--placeholder">
    <span class="project-image-placeholder-text">{{title}}</span>
  </div>
  {{/if}}
  <div class="project-body">
    <div class="project-title">{{title}}</div>
    <div class="project-description">{{description}}</div>
    {{#if link}}<a href="{{link}}" class="tag-link" target="_blank" rel="noopener">GitHub</a>{{/if}}
  </div>
</div>

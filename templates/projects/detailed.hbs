<div class="entry-row">
  {{#if image}}
  <div class="entry-thumb">
    <picture>
      <source srcset="{{webp image}}" type="image/webp">
      <img src="{{image}}" alt="{{title}}" width="700" height="438" loading="lazy" decoding="async" />
    </picture>
  </div>
  {{else}}
  <div class="entry-thumb entry-thumb--placeholder">
    <span class="entry-thumb-placeholder-text">{{title}}</span>
  </div>
  {{/if}}
  <div class="entry-info">
    <div class="entry-title">{{title}}</div>
    {{#if description}}<div class="entry-desc">{{description}}</div>{{/if}}
    {{#if org}}<div class="entry-meta">{{org}}{{#if dates}} · {{dates}}{{/if}}</div>{{/if}}
    {{#if authors}}<div class="entry-authors">{{{authorsHtml}}}</div>{{/if}}
    {{#if links}}
    <div class="entry-links">
      {{#each links}}<a href="{{this.url}}" class="entry-link" target="_blank" rel="noopener">[{{this.label}}]</a>{{/each}}
    </div>
    {{else if link}}
    <div class="entry-links"><a href="{{link}}" class="entry-link" target="_blank" rel="noopener">[GitHub]</a></div>
    {{/if}}
  </div>
</div>

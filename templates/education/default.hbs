<div class="edu-item">
  {{#if logo}}
  <img
    src="{{lqip logo}}"
    data-src="{{logo}}"
    alt="{{institution}} logo"
    class="edu-logo lazy-img"
    width="36"
    height="36"
    loading="lazy"
    decoding="async"
  />
  {{/if}}
  <div class="edu-body">
    <div class="edu-institution-line">{{institution}} — <span class="edu-dates">{{dates}}</span></div>
    <div class="edu-degree">{{degree}}</div>
    {{#if detail}}<div class="edu-detail">{{detail}}</div>{{/if}}
    {{#if courses}}<div class="edu-courses">Coursework: {{courses}}</div>{{/if}}
  </div>
</div>

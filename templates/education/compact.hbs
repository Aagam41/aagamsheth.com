<div class="edu-item edu-item--compact">
  {{#if logo}}<img src="{{lqip logo}}" data-src="{{logo}}" alt="{{institution}} logo" class="edu-logo edu-logo--inline lazy-img" width="16" height="16" loading="lazy" decoding="async" />{{/if}}
  <span class="edu-institution">{{institution}}</span> — <span class="edu-dates">{{dates}}</span>, <span class="edu-degree">{{degree}}</span>
</div>

<div class="edu-item edu-item--compact">
  {{#if logo}}<picture><source srcset="{{webp logo}}" type="image/webp"><img src="{{logo}}" alt="{{institution}} logo" class="edu-logo edu-logo--inline" width="16" height="16" loading="lazy" decoding="async" /></picture>{{/if}}
  <span class="edu-institution">{{institution}}</span> — <span class="edu-dates">{{dates}}</span>, <span class="edu-degree">{{degree}}</span>
</div>

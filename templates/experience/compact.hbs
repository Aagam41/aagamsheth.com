<div class="exp-item exp-item--compact">
  {{#if logo}}<img src="{{lqip logo}}" data-src="{{logo}}" alt="{{org}} logo" class="exp-logo exp-logo--inline lazy-img" width="16" height="16" loading="lazy" decoding="async" />{{/if}}
  <span class="exp-role">{{role}}</span> — <span class="exp-dates">{{dates_label}}</span>, <span class="exp-org">{{org}}</span>
</div>

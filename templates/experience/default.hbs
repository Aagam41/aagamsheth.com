<div class="exp-item">
  <div class="exp-body">
    {{#if companyHeader}}
    <div class="exp-company-line">
      {{#if logo}}<img src="{{lqip logo}}" data-src="{{logo}}" alt="{{org}} logo" class="exp-logo lazy-img" width="36" height="36" loading="lazy" decoding="async" />{{/if}}
      <span class="exp-company">{{org}}</span>
    </div>
    {{/if}}
    <div class="exp-role-line">{{role}} · <span class="exp-dates">{{dates_label}}</span></div>
    {{#if context}}<div class="exp-context">{{context}}</div>{{/if}}
    {{#if description}}<div class="exp-description">{{description}}</div>{{/if}}
  </div>
</div>

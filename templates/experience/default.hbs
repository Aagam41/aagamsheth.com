<div class="exp-item">
  {{#if logo}}
  <img
    src="{{logo}}"
    alt="{{org}} logo"
    class="exp-logo"
  />
  {{/if}}
  <div class="exp-body">
    <div class="exp-role-line">{{role}}</div>
    <div class="exp-org">{{org}} · <span class="exp-dates">{{dates_label}}</span></div>
    {{#if description}}<div class="exp-description">{{description}}</div>{{/if}}
  </div>
</div>
